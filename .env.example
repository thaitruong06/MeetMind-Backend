# Sao chép thành .env (không commit). Trên Cloud Run đặt qua --set-env-vars / Secret Manager.
NODE_ENV=development
PORT=8080

# Cùng project với Firebase của app Android
GCP_PROJECT_ID=your-firebase-project-id
STORAGE_BUCKET=your-project-meetmind-audio

# Lấy ở https://aistudio.google.com/apikey (free tier). Không bao giờ đưa vào app Android.
GEMINI_API_KEY=
# Kiểm tra model free tier còn hoạt động trong AI Studio rồi đổi nếu cần
GEMINI_MODEL=gemini-2.5-flash

MAX_AUDIO_MB=200

# Chạy local: gcloud auth application-default login (hoặc trỏ tới file khóa service account)
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
